datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?

  ingredients  String?
  instructions String?

  image        String?
  imagePrompt  String?

  category     String?
  cuisine      String?

  servings     Int?


  createdAt    DateTime @default(now())
}